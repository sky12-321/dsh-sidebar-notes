{
  "name": "dsh-sidebar-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds a Quick Notes scratchpad panel with a left sidebar entry to the Harness Web UI.",
  "author": "sky12-321",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sky12-321/dsh-sidebar-notes.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
